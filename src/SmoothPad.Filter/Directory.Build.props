<?xml version="1.0" encoding="utf-8"?>
<!--
  Shadow the repo-root Directory.Build.props. Kernel projects cannot inherit
  the user-mode toolset, /std:c++latest, or v145 settings.
-->
<Project>
  <PropertyGroup>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'==''">10.0.26100.0</WindowsTargetPlatformVersion>
    <CharacterSet>Unicode</CharacterSet>
    <OutDir>$(MSBuildThisFileDirectory)..\..\out\$(Platform)\$(Configuration)\filter\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\out\obj\SmoothPad.Filter\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
